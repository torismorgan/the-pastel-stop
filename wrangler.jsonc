{
  "name": "the-pastel-stop",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // the Worker sees every request now (needed so it can gate pages behind WAITLIST_MODE);
    // it passes almost everything straight through to env.ASSETS.fetch() unchanged
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pastel-stop",
      "database_id": "db3e546b-3763-4a4e-beb0-bfbfc5e9305d"
    }
  ],
  "vars": {
    // MailerLite group new subscribers are added to (not a secret). Leave "" to add them without a group.
    "MAILERLITE_GROUP_ID": "199540437257553462",
    // Pre-launch gate: "true" shows waitlist.html for every page except /admin, /privacy and
    // /terms. Set to "false" (or delete the line) and redeploy to open the real site — every
    // real page is untouched underneath and needs no further changes.
    "WAITLIST_MODE": "true"
  }
}
